# ==============================================================================
# PREMIUM PHOTOGRAPHY PORTFOLIO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit your actual .env or .env.local files to Git.

# --- Public Site Metadata ---
NEXT_PUBLIC_SITE_NAME="Aura Atelier | Cinematic Photography"
NEXT_PUBLIC_PHOTOGRAPHER_NAME="Aura & Light"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Google Drive Configuration (Server-Side Only) ---
# Set these to enable live Google Drive synchronization.
# If left empty, the site seamlessly runs in high-performance Curated Seed / Fallback mode.
GOOGLE_DRIVE_ROOT_FOLDER_ID=""
GOOGLE_DRIVE_WEDDING_FOLDER_ID=""
GOOGLE_DRIVE_PREWEDDING_FOLDER_ID=""
GOOGLE_DRIVE_BIRTHDAY_FOLDER_ID=""
GOOGLE_DRIVE_PORTRAIT_FOLDER_ID=""
GOOGLE_DRIVE_FASHION_FOLDER_ID=""
GOOGLE_DRIVE_EVENTS_FOLDER_ID=""
GOOGLE_DRIVE_COMMERCIAL_FOLDER_ID=""

# Google Service Account Credentials (Server-Side Only)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Note: In .env.local, ensure private key preserves \n or standard PEM formatting
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# Optional API Key fallback for publicly shared Drive folders
GOOGLE_API_KEY=""

# Cache Duration for Drive Metadata (in seconds, default: 3600 = 1 hour)
GOOGLE_DRIVE_CACHE_TTL="3600"

# --- Inquiries & Notifications ---
# Recipient email for contact inquiries
INQUIRY_RECIPIENT_EMAIL="inquiries@example.com"
# Optional SMTP or transactional service (Resend / SendGrid / Postmark)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@example.com"
